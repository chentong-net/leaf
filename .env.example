# Copy this file to .env and adjust paths for the current machine.
# The root leaf.sh script sources .env and intentionally overrides inherited values.

export LEAF_ANDROID_SDK=
export LEAF_ANDROID_NDK=
export LEAF_JAVA_HOME=
export LEAF_EMSDK=
export LEAF_XCODE_DEVELOPER_DIR=
export LEAF_IOS_DEVELOPMENT_TEAM=
export LEAF_OHOS_SDK=
export LEAF_HVIGOR=
export LEAF_OHOS_JAVA_HOME=
export LEAF_ADB=
export LEAF_HDC=
export LEAF_WEB_PORT=8000
